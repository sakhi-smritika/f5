# Logging
# Valid values: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOGGING_LEVEL=INFO

# Environment
# Valid values: local, production
ENVIRONMENT=
CORS_ORIGINS=

# To Validate the connections and api keys using ping functions
# Valid values: true, false
PING=

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
#   In case of IPv4 or localhost:
#   postgresql+asyncpg://postgres:<password>@<host>:54322/postgres
#   In case of IPv6:
#   postgresql+asyncpg://postgres.<your-project-id>:<password>@<host>:5432/postgres
DATABASE_URL=

# Chatbot (ADK)
# Provider API keys
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Ollama (local models via LiteLLM). Use ollama_chat/ prefix in CHAT_MODELS.
# OLLAMA_API_KEY is optional locally; LiteLLM accepts the placeholder "ollama".
OLLAMA_BASE_URL=http://localhost:11434
# Comma-separated list of models for the chat UI as id|Label pairs (or id only).
# The first entry is the default. Use LiteLLM provider prefixes; the matching
# provider API key (or OLLAMA_BASE_URL for ollama_chat/) must be configured.
# Example: ollama_chat/qwen2.5:0.5b|Qwen 2.5 0.5B,openai/gpt-4o|GPT-4o,gemini/gemini-2.0-flash|Gemini,anthropic/claude-sonnet-4-6|Claude Sonnet 4.6
CHAT_MODELS=

# Web search (Parallel MCP — free tier needs no key)
# Optional: PARALLEL_API_KEY for higher rate limits
# Optional: PARALLEL_MCP_URL (default https://search.parallel.ai/mcp)

# Google Workspace integration (Calendar + Tasks)
# OAuth 2.0 Web-application client credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI on the OAuth client, e.g.
#   http://localhost:8080/api/v1/integrations/google/callback (local)
GOOGLE_OAUTH_REDIRECT_URI=
# Where the backend sends the user back after Google consent by default
# (web), e.g. http://localhost:5173/settings. iOS passes
# success_redirect=sakhi-smritika://oauth on authorize instead.
GOOGLE_OAUTH_SUCCESS_REDIRECT=
# Fernet key used to encrypt stored Google refresh tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENC_KEY=
