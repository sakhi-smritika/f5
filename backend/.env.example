# Logging
# Valid values: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOGGING_LEVEL=INFO

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Chatbot (ADK)
# OpenAI key used by the agent (via LiteLLM)
OPENAI_API_KEY=
# LiteLLM model string (defaults to openai/gpt-4o)
OPENAI_MODEL=openai/gpt-4o
# Async SQLAlchemy URL for ADK session persistence. Point this at your Supabase
# Postgres (Database settings -> Connection string), using the DB password:
#   postgresql+asyncpg://postgres:<password>@<host>:5432/postgres
DATABASE_URL=

# Google Workspace integration (Calendar + Tasks)
# OAuth 2.0 Web-application client credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI on the OAuth client, e.g.
#   http://localhost:8080/api/v1/integrations/google/callback (local)
GOOGLE_OAUTH_REDIRECT_URI=
# Where the backend sends the user back in the app after the Google consent
# flow finishes, e.g. http://localhost:5173/settings
GOOGLE_OAUTH_SUCCESS_REDIRECT=
# Fernet key used to encrypt stored Google refresh tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENC_KEY=

# Environment
# Valid values: local, production
ENVIRONMENT=

# Valid values: true, false
PING=